# GroqCloud  -> https://console.groq.com/keys
# Starts with gsk_
GROQ_API_KEY=

# Hugging Face -> https://huggingface.co/settings/tokens
# Must be a FINE-GRAINED token with "Make calls to Inference Providers".
# Starts with hf_
HF_API_KEY=
